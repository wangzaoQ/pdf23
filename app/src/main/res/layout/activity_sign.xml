<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5F9FE"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        >
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:foreground="?android:selectableItemBackgroundBorderless"
            android:tint="@color/black"
            app:srcCompat="@drawable/ic_back"></androidx.appcompat.widget.AppCompatImageView>


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="50dp"
            android:text="@string/app_clear"
            style="@style/app_text_bold"
            android:textColor="#1E3A5F"
            ></androidx.appcompat.widget.AppCompatTextView>
    </RelativeLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcAddSign"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardElevation="0dp"
        android:layout_marginHorizontal="40dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white"
        app:shapeAppearanceOverlay="@style/Round12Shape">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_signature_canvas"
            >
            <com.pdf.editor.ui.detail.add.SignatureView
                android:id="@+id/signView"
                android:layout_margin="6dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                ></com.pdf.editor.ui.detail.add.SignatureView>
        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/mcFinish"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="13dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_save"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        style="@style/app_text_bold"
        android:layout_marginBottom="12dp"
        android:layout_centerVertical="true"
        android:layout_gravity="end"
        android:layout_alignParentEnd="true"
        android:background="@drawable/shape_commit"
        android:foreground="@drawable/ripple_reader_item"
        ></androidx.appcompat.widget.AppCompatTextView>

</androidx.appcompat.widget.LinearLayoutCompat>