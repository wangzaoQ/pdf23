<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F7">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="432dp"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_start" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="166dp"
        android:gravity="center"
        >
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="94dp"
            android:layout_height="94dp"
            app:shapeAppearance="@style/style_round_style_8r"
            android:scaleType="centerCrop"
            app:srcCompat="@mipmap/ic_nf_logo"
            ></com.google.android.material.imageview.ShapeableImageView>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/app_start_tips"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#FF090A0A"
            style="@style/app_text_bold"
            android:layout_marginTop="24dp"
            ></androidx.appcompat.widget.AppCompatTextView>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <ProgressBar
        android:layout_marginHorizontal="34dp"
        android:layout_marginBottom="94dp"
        android:layout_gravity="bottom"
        android:id="@+id/progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:max="100"
        android:progressDrawable="@drawable/shape_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:progress="0" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF0F172A"
        android:textSize="25sp"
        style="@style/app_text_bold"
        android:layout_marginBottom="50dp"
        android:layout_gravity="bottom|center"
        tools:text="1"
        ></androidx.appcompat.widget.AppCompatTextView>
</FrameLayout>
