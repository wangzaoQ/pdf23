<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBFB"
    android:orientation="vertical">

    <!-- 与语言选择页保持同一套项目标题栏。 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:background="@drawable/bg_common_top1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_alignParentBottom="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBack"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                android:contentDescription="@string/app_back"
                app:srcCompat="@drawable/ic_back" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                style="@style/app_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:ellipsize="end"
                android:maxWidth="260dp"
                android:maxLines="1"
                android:text="@string/app_selected_one_file"
                android:textColor="@color/white"
                android:textSize="17sp" />
        </RelativeLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="121dp"
                android:layout_height="88dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_empty" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/app_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/app_file_empty"
                android:textColor="#8396B1"
                android:textSize="15sp" />
        </LinearLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/permissionState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="73dp"
                android:layout_height="73dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_no_permission" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/app_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/app_permission_title"
                android:textColor="#0F172A"
                android:textSize="19sp" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/app_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/app_permission_content"
                android:textColor="#7B7B7B"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/enableFileAccess"
                style="@style/app_text_bold"
                android:layout_width="225dp"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/shape_commit"
                android:text="@string/app_go_to_setting"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

    <!-- 合并模式才显示；按钮样式沿用项目通用主按钮。 -->
    <FrameLayout
        android:id="@+id/mergeFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7FBFB">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            style="@style/app_text_bold"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/selector_action_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Continue (2 selected)"
            tools:visibility="visible" />
    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
