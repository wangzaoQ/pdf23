<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FE"
 >
<androidx.appcompat.widget.LinearLayoutCompat
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    >
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="vertical"
        android:paddingTop="42dp"
        android:background="@drawable/bg_common_top1"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="15dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:foreground="?android:selectableItemBackgroundBorderless"
                app:srcCompat="@drawable/ic_back"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/uninstall_why_title"
                android:textColor="@color/white"
                android:textSize="16sp"
                style="@style/app_text_bold" />
        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/uninstall_better_experience"
        android:textColor="#082F36"
        android:textSize="18sp"
        style="@style/app_text_bold" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/shape_white_14r"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="14dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">



        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/uninstall_reason_pdf_hard"
            android:textColor="#FF082F36"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTryAgain"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_commit"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/uninstall_action_try_again"
            style="@style/app_text_bold"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/shape_white_14r"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:layout_marginHorizontal="14dp"
        android:paddingEnd="12dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/uninstall_reason_feature_missing"
            android:textColor="#FF082F36"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTryAgain2"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_commit"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            style="@style/app_text_bold"
            android:text="@string/uninstall_action_explore_more"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </androidx.appcompat.widget.LinearLayoutCompat>



</androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="16dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPersistUninstall"
            android:layout_width="92dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_uninstall_later"
            android:foreground="?android:selectableItemBackground"
            android:gravity="center"
            android:text="@string/app_later"
            android:textColor="#7891A8"
            android:textSize="14sp"
            style="@style/app_text_normal" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnKeepApp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/shape_commit"
            android:gravity="center"
            android:text="@string/app_continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.LinearLayoutCompat>
    <FrameLayout
        android:id="@+id/flADRoot2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/shape_native_bg"
        ></FrameLayout>



</RelativeLayout>
