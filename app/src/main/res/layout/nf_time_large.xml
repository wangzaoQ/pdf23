<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/rlRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="265dp"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@mipmap/ic_nf_logo"
        android:layout_marginTop="15dp"
        android:layout_marginStart="14dp"
        ></ImageView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="66dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="10dp"
        >
        <TextView
            android:id="@+id/tvPushTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/app_nf_content"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#1E3A5F"
            style="@style/app_text_bold"
            ></TextView>

        <TextView
            android:id="@+id/tvPushContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/app_nf_content"
            android:layout_toStartOf="@+id/rlBtn"
            android:layout_marginTop="4dp"
            android:textSize="10sp"
            android:textColor="#7B7B7B"
            android:ellipsize="end"
            android:maxLines="2"
            ></TextView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="74dp"
        >
        <ImageView
            android:id="@+id/ivNFPic"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginHorizontal="14dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:src="@drawable/ic_nf_large"
            android:scaleType="fitCenter"
            ></ImageView>
        <RelativeLayout
            android:id="@+id/rlBtn"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="30dp"
            android:layout_alignParentEnd="true"
            >
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_nf_animal_btn1"
                android:paddingHorizontal="10dp"
                ></ImageView>
            <TextView
                android:id="@+id/tvBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/app_open"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                style="@style/app_text_bold"
                ></TextView>
        </RelativeLayout>
    </LinearLayout>





</RelativeLayout>
