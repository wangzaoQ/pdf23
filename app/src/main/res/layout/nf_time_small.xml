<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/rlRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@mipmap/ic_nf_logo"
        android:layout_marginStart="10dp"
        android:layout_centerVertical="true"
        ></ImageView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="65dp"
        android:layout_marginEnd="7dp"
        android:orientation="vertical"
        android:layout_toStartOf="@+id/rlBtn"
        >
        <TextView
            android:id="@+id/tvPushTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/app_nf_content"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1E3A5F"
            style="@style/app_text_bold"
            ></TextView>
        <TextView
            android:id="@+id/tvPushContent"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/app_nf_content"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#64748B"
            style="@style/app_text_bold"
            ></TextView>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rlBtn"
        android:layout_centerVertical="true"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_nf_animal_btn2"
            ></ImageView>
        <TextView
            android:id="@+id/tvBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/app_open"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            ></TextView>
    </RelativeLayout>
</RelativeLayout>
