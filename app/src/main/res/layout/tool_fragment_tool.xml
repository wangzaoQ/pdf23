<?xml version="1.0" encoding="utf-8"?><!-- PDF14-MIGRATION: 原样迁入 pdf14 小工具资源，仅隔离资源名、引用及控件包路径；未改页面逻辑。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F5">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="432dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_start" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="51dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/app_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tools"
            android:textColor="#10766E"
            android:textSize="23sp"></androidx.appcompat.widget.AppCompatTextView>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/app_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:text="@string/app_and"
            android:textColor="#0E172A"
            android:textSize="23sp"></androidx.appcompat.widget.AppCompatTextView>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/app_text_bold2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="@string/app_setting"
            android:textColor="#0E172A"
            android:textSize="23sp"></androidx.appcompat.widget.AppCompatTextView>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="102dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/app_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/app_pdf_tools"
                android:textColor="#0F172A"
                android:textSize="17sp"></androidx.appcompat.widget.AppCompatTextView>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginHorizontal="13dp"
                android:layout_marginTop="17dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/scanToPdfButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="5dp"
                        app:srcCompat="@drawable/ic_tool_scan"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_scan_to_pdf"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/word2PDF"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="5dp"
                        app:srcCompat="@drawable/ic_tool_w2p"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_word_to_pdf"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginHorizontal="13dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pdf2Img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="5dp"
                        app:srcCompat="@drawable/ic_tool_p2i"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_pdf_to_image"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/imageToPdfButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="5dp"
                        app:srcCompat="@drawable/ic_tool_i2p"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_img_to_pdf"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginHorizontal="13dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/mergePDF"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="5dp"
                        app:srcCompat="@drawable/ic_tool_merge"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_pdf_merge_pdf"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/splitPDF"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="5dp"
                        app:srcCompat="@drawable/ic_tool_split"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_split_pdf"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginHorizontal="13dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pdf2word"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="5dp"
                        app:srcCompat="@drawable/ic_tool_p2w"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_pdf_to_word"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_shape_tools"
                    android:visibility="invisible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="11dp"
                        app:srcCompat="@drawable/ic_tool_split"></androidx.appcompat.widget.AppCompatImageView>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/app_text_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:text="@string/app_split_pdf"
                        android:textColor="#1E3A5F"
                        android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                </FrameLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/app_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:text="@string/app_system"
                android:textColor="#0F172A"
                android:textSize="18sp"></androidx.appcompat.widget.AppCompatTextView>

            <RelativeLayout
                android:id="@+id/flAddWidget"
                android:layout_width="match_parent"
                android:layout_height="71dp"
                android:layout_marginTop="9dp"
                android:layout_marginHorizontal="17dp"
                android:background="@drawable/bg_shape_tools">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:srcCompat="@drawable/ic_tool_add_widget"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="13dp"
                    ></androidx.appcompat.widget.AppCompatImageView>
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/app_text_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="71dp"
                    android:text="@string/app_add_widget"
                    android:textColor="#0F766E"
                    android:layout_centerVertical="true"
                    android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddWidget"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="13dp"
                    android:text="@string/app_add"
                    android:background="@drawable/shape_commit"
                    ></androidx.appcompat.widget.AppCompatButton>
            </RelativeLayout>


            <androidx.appcompat.widget.AppCompatTextView
                style="@style/app_text_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginTop="22dp"
                android:text="@string/app_preferences"
                android:textColor="#0F172A"
                android:textSize="18sp"></androidx.appcompat.widget.AppCompatTextView>

            <RelativeLayout
                android:id="@+id/rlLanguage"
                android:layout_width="match_parent"
                android:layout_height="71dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_shape_tools">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="15dp"
                    app:srcCompat="@drawable/ic_app_language"></androidx.appcompat.widget.AppCompatImageView>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/app_text_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="68dp"
                    android:text="@string/app_language"
                    android:textColor="#0F172A"
                    android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="11dp"
                    app:srcCompat="@drawable/ic_tool_arrow"></androidx.appcompat.widget.AppCompatImageView>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="37dp"
                    android:textColor="#828282"
                    android:textSize="13sp"
                    tools:text="11"></androidx.appcompat.widget.AppCompatTextView>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlPrivate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shape_tools"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/app_text_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:text="@string/app_privacy"
                    android:textColor="#0F172A"
                    android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="11dp"
                    app:srcCompat="@drawable/ic_tool_arrow"></androidx.appcompat.widget.AppCompatImageView>

            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlTerms"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shape_tools"
                android:layout_marginBottom="13dp"
                >

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/app_text_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:text="@string/app_terms"
                    android:textColor="#0F172A"
                    android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="11dp"
                    app:srcCompat="@drawable/ic_tool_arrow"></androidx.appcompat.widget.AppCompatImageView>

            </RelativeLayout>


        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
