<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FBFB"
   >
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="432dp"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_start" />
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="233dp"
            android:layout_marginHorizontal="20dp"
            app:srcCompat="@drawable/bg_nf_top"
            android:layout_gravity="center_horizontal"
            ></androidx.appcompat.widget.AppCompatImageView>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/app_text_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="@string/app_nf_guide_title"
            android:textColor="#FF0F172A"
            android:textSize="21sp"></androidx.appcompat.widget.AppCompatTextView>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/app_text_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="26dp"
            android:layout_marginTop="11dp"
            android:gravity="center"
            android:text="@string/app_nf_guide_content"
            android:textColor="#FF64748B"
            android:textSize="15sp"></androidx.appcompat.widget.AppCompatTextView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/bg_nf_tips"
            android:layout_marginTop="28dp"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                app:srcCompat="@mipmap/ic_nf_logo"
                >
            </androidx.appcompat.widget.AppCompatImageView>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginStart="76dp"
                android:layout_marginEnd="64dp"
                android:gravity="center_vertical"
                >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                style="@style/app_text_bold"
                android:textSize="14sp"
                ></androidx.appcompat.widget.AppCompatTextView>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_all_noti"
                    android:textSize="12sp"
                    android:textColor="#B3B3B3"
                    android:layout_marginTop="8dp"
                    style="@style/app_text_normal"
                    ></androidx.appcompat.widget.AppCompatTextView>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <FrameLayout
                android:id="@+id/switchRoot"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_centerVertical="true"
                >

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_switch1" />
            </FrameLayout>
        </RelativeLayout>


    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        >
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_nf_guide_tips1"
            android:textSize="15sp"
            android:textColor="#FF64748B"
            android:layout_gravity="center_horizontal"
            style="@style/app_text_bold"
            ></androidx.appcompat.widget.AppCompatTextView>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_nf_guide_tips2"
            android:textSize="15sp"
            android:textColor="#FF64748B"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_horizontal"
            style="@style/app_text_bold"
            ></androidx.appcompat.widget.AppCompatTextView>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="11dp"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLater"
                android:layout_width="105dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_gravity="center_horizontal"
                android:textColor="#FF8396B1"
                android:background="@drawable/shape_later"
                android:textSize="15sp"
                android:text="@string/app_later"
                android:gravity="center"
                ></androidx.appcompat.widget.AppCompatTextView>

            <FrameLayout
                android:id="@+id/flCommit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="11dp"
                android:background="@drawable/shape_commit"
                android:clipChildren="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clipToOutline="true">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCommit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_commit"
                    android:text="@string/app_start_now"
                    android:textAllCaps="false"
                    android:gravity="center"
                    style="@style/app_text_bold"
                    android:textColor="@color/white"
                    android:textSize="17sp"></androidx.appcompat.widget.AppCompatTextView>
                <View
                    android:id="@+id/vCommitShine"
                    android:layout_width="58dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center_vertical"
                    android:alpha="0.65"
                    android:background="@drawable/bg_primary_action_shimmer"
                    android:importantForAccessibility="no"
                    android:rotation="18" />

            </FrameLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>
   </androidx.appcompat.widget.LinearLayoutCompat>

</RelativeLayout>
