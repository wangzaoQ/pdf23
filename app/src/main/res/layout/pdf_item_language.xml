<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlLanguage"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/shape_language_item"
    android:foreground="?android:selectableItemBackgroundBorderless"
    android:gravity="center_vertical"
    >
    
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLanguage"
        android:layout_width="37dp"
        android:layout_height="37dp"
        app:srcCompat="@drawable/ic_usa"
        android:layout_centerVertical="true"
        android:layout_marginStart="59dp"
        ></androidx.appcompat.widget.AppCompatImageView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLanguage"
        style="@style/app_text_bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:layout_marginStart="109dp"
        android:layout_centerVertical="true"
        android:textColor="#0F172A"
        tools:text="English"></androidx.appcompat.widget.AppCompatTextView>
    
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSelected"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:srcCompat="@drawable/ic_unselected"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        ></androidx.appcompat.widget.AppCompatImageView>
</RelativeLayout>