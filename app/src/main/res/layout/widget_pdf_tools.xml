<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="172dp"
    android:background="@drawable/shape_white_16r"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="16dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_nf_logo" />

        <TextView
            android:id="@+id/widgetTitle"
            style="@style/app_text_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:text="@string/app_name"
            android:textColor="#111216"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_widget_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search" />

        <TextView
            android:id="@+id/widgetSearchHint"
            style="@style/app_text_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:includeFontPadding="false"
            android:text="@string/app_home_search_hint"
            android:textColor="#FFB3B3B3"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widgetHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="1dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_nf_home" />

            <TextView
                android:id="@+id/widgetHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/app_home"
                android:layout_marginTop="3dp"
                style="@style/app_text_bold"
                android:textColor="#FF090A0A"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="1dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_nf_search" />

            <TextView
                android:id="@+id/widgetSearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/app_search"
                android:layout_marginTop="3dp"
                style="@style/app_text_bold"
                android:textColor="#FF090A0A"
                android:textSize="12sp"  />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetScan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="1dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_nf_scan" />

            <TextView
                android:id="@+id/widgetScanLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/app_scan"
                android:layout_marginTop="3dp"
                style="@style/app_text_bold"
                android:textColor="#FF090A0A"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetConvert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="1dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_nf_convert" />

            <TextView
                android:id="@+id/widgetConvertLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/app_convert"
                android:layout_marginTop="3dp"
                style="@style/app_text_bold"
                android:textColor="#FF090A0A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
